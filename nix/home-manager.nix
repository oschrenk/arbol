# home-manager module for arbol.
#
#   inputs.arbol.url = "github:oschrenk/arbol";
#   imports = [ inputs.arbol.homeModules.arbol ];
#
#   programs.arbol = {
#     enable = true;
#     accounts.default = {
#       default = true;
#       root    = "~/Projects";
#       repos.tools = [ "git@github.com:oschrenk/arbol.git" ];
#     };
#   };
#
# Generates $XDG_CONFIG_HOME/arbol/config.toml, which is the path
# config.ConfigPath() reads.
self:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  inherit (lib)
    literalExpression
    mkEnableOption
    mkIf
    mkOption
    types
    ;

  cfg = config.programs.arbol;

  # A repo is a URL string, coerced to the { url, name } shape the TOML uses.
  repoType = types.coercedTo types.str (url: { inherit url; }) (
    types.submodule {
      options = {
        url = mkOption {
          type = types.str;
          example = "git@github.com:oschrenk/arbol.git";
          description = "Git URL to clone from.";
        };
        name = mkOption {
          type = types.nullOr types.str;
          default = null;
          description = ''
            Directory name to clone into. Defaults to the name derived from
            {option}`url`.
          '';
        };
      };
    }
  );

  accountType = types.submodule {
    options = {
      default = mkOption {
        type = types.bool;
        default = false;
        description = ''
          Use this account when `--account` is not passed. At most one account
          may set this.
        '';
      };

      root = mkOption {
        type = types.str;
        example = "~/Projects";
        description = "Directory the repo tree is rooted at. A leading `~/` is expanded by arbol.";
      };

      repos = mkOption {
        type = types.attrsOf (types.listOf repoType);
        default = { };
        example = literalExpression ''
          {
            tools = [ "git@github.com:oschrenk/arbol.git" ];
            "work.backend" = [
              "git@github.com:company/api.git"
              { url = "git@github.com:company/worker.git"; name = "worker-svc"; }
            ];
          }
        '';
        description = ''
          Repos keyed by dotted path below {option}`root`, so `"work.backend"`
          clones into `<root>/work/backend`. The key is the same path `arbol
          status` and `arbol sync` accept as a filter.
        '';
      };
    };
  };

  # TOML is emitted by hand rather than through pkgs.formats.toml so the
  # generated file keeps the inline-table layout arbol's docs and `arbol init`
  # use, and so dotted repo paths stay dotted instead of becoming quoted keys.
  quote = s: ''"'' + lib.escape [ ''\'' ''"'' ] s + ''"'';
  key = seg: if builtins.match "[A-Za-z0-9_-]+" seg == null then quote seg else seg;

  # TOML cannot hold a value and a table at the same key, so a path that has
  # both its own repos and subpaths writes its repos under a "/" child.
  pathKey =
    paths: p:
    lib.concatStringsSep "." (map key (lib.splitString "." p))
    + lib.optionalString (lib.any (q: lib.hasPrefix "${p}." q) paths) ''."/"'';

  repoLine =
    repo:
    "  { url = ${quote repo.url}"
    + lib.optionalString (repo.name != null) ", name = ${quote repo.name}"
    + " },";

  reposBlocks =
    repos:
    let
      paths = lib.attrNames repos;
      block =
        p:
        lib.concatStringsSep "\n" (
          [ "repos.${pathKey paths p} = [" ] ++ map repoLine repos.${p} ++ [ "]" ]
        );
    in
    map block (lib.filter (p: repos.${p} != [ ]) paths);

  accountBlock =
    name: account:
    lib.concatStringsSep "\n\n" (
      [
        (lib.concatStringsSep "\n" [
          "[accounts.${key name}]"
          "default = ${lib.boolToString account.default}"
          "root    = ${quote account.root}"
        ])
      ]
      ++ reposBlocks account.repos
    );

  configText =
    lib.concatStringsSep "\n\n" (
      [ "# Generated by home-manager from programs.arbol. Do not edit." ]
      ++ lib.mapAttrsToList accountBlock cfg.accounts
    )
    + "\n";
in
{
  options.programs.arbol = {
    enable = mkEnableOption "arbol, a manager for git repositories across machines";

    package = mkOption {
      type = types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.arbol;
      defaultText = literalExpression "arbol.packages.\${system}.arbol";
      description = "The arbol package to install.";
    };

    accounts = mkOption {
      type = types.attrsOf accountType;
      default = { };
      description = ''
        Machine profiles. Each account has its own root directory and repo
        tree; `arbol --account <name>` selects one.
      '';
    };
  };

  config = mkIf cfg.enable {
    assertions = [
      {
        assertion = lib.count (account: account.default) (lib.attrValues cfg.accounts) <= 1;
        message = "programs.arbol: at most one account may set `default = true`.";
      }
    ];

    home.packages = [ cfg.package ];

    xdg.configFile."arbol/config.toml" = mkIf (cfg.accounts != { }) { text = configText; };
  };
}
